# Configuration d'environnement FaceIN (exemple)
# Copier ce fichier vers .env pour le développement local.
# En production, fournir des secrets forts et ne JAMAIS commiter .env.

# --- PostgreSQL ---
POSTGRES_DB=facein
POSTGRES_USER=facein_user
POSTGRES_PASSWORD=change-me-in-local-env

# --- JWT & Sessions ---
# Générer en prod avec : openssl rand -hex 32
JWT_SECRET_KEY=change-me-dev-jwt-secret-minimum-32-chars
JWT_SECRET_KEY_PREVIOUS=
JWT_ENV=development
JWT_EXPIRATION_SECONDS=3600

# --- ZKP & Consensus ---
# FACEIN_ENV=production interdit toute simulation (démarrage refusé si MOCK_ZKP_VERIFICATION=true).
# Les votes de consensus ne sont jamais simulés, quel que soit l'environnement.
FACEIN_ENV=development
MOCK_ZKP_VERIFICATION=false
DISTANCE_THRESHOLD=16000000

# --- TLS / mTLS ---
TLS_ENABLED=true
TLS_CA_CERT_HOST_PATH=./nodes/infra/tls/ca.crt
